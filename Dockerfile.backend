# Dockerfile for Portfolix Backend
FROM python:3.11-slim as backend

WORKDIR /app

# Install system build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast Python package management
RUN pip install --no-cache-dir uv

# Copy project definition and requirements
COPY pyproject.toml ./
RUN uv pip install --system -r pyproject.toml || uv pip install --system "fastapi" "uvicorn[standard]" "sqlalchemy>=2.0" "alembic" "pydantic>=2.0" "pandas" "numpy" "scipy" "statsmodels" "scikit-learn" "python-jose[cryptography]" "passlib[bcrypt]" "bcrypt" "python-multipart" "httpx" "pytest" "pytest-asyncio"

# Copy source code and dataset
COPY backend/ ./backend/
COPY scripts/ ./scripts/
COPY data/ ./data/

# Environment defaults
ENV PYTHONPATH=/app
ENV PORT=8000
ENV HOST=0.0.0.0

EXPOSE 8000

# Run ETL script on startup then start FastAPI
CMD ["sh", "-c", "python scripts/ingest_csv.py && uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"]
